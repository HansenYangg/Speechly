# Flask Configuration
FLASK_ENV=development  # development, production, or testing
SECRET_KEY=your-secret-key-here-change-in-production

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration
# For local development, leave commented to use default SQLite (dev.db)
# DATABASE_URL=sqlite:///dev.db

# For production with PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:port/database

# Storage Configuration
STORAGE_MODE=database  # 'database' or 'file'
AUDIO_STORAGE=file  # 'file' (local development) or 'base64' (cloud deployment)

# Directory Paths (optional - defaults are set in config)
# RECORDINGS_DIR=recordings
# DATA_DIR=data
# LOGS_DIR=logs

# CORS Configuration (for production)
# CORS_ORIGINS=https://your-frontend-domain.com,https://another-domain.com

# Server Configuration
# PORT=5001  # Optional, defaults to 5001
